<!-- tesserabom decoders -->
<!--
  Bare JSON lines are handled by Wazuh's built-in json decoder, so only the wrapped
  command-wodle form needs a decoder. Wazuh's built-in "ossec" decoder claims those
  lines first, so this is a child of it that parses the JSON payload.
-->
<decoder name="tesserabom-json">
  <parent>ossec</parent>
  <prematch offset="after_parent">^output: 'tesserabom': </prematch>
  <plugin_decoder offset="after_prematch">JSON_Decoder</plugin_decoder>
</decoder>

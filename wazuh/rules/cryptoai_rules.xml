<!-- wazuh-cryptoai-inventory rules. IDs 100900-100999 are reserved for this add-on. -->
<!-- Compliance groups are lookup tags for dashboards and reports. They are not a statement of compliance. -->
<group name="cryptoai,">
  <rule id="100900" level="0">
    <decoded_as>cryptoai</decoded_as>
    <description>cryptoai-inventory event.</description>
  </rule>
  <rule id="100901" level="3">
    <if_sid>100900</if_sid>
    <field name="cryptoai.event">^summary$</field>
    <description>cryptoai-inventory scan summary.</description>
    <group>cryptoai_summary,</group>
  </rule>
  <rule id="100902" level="10">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^cert_expired$</field>
    <description>Expired X.509 certificate in use: $(cryptoai.detail)</description>
    <group>pci_dss_12.3.3,dora_rts_2024_1774_art6,nydfs_500.15,dora_rts_2024_1774_art7,</group>
  </rule>
  <rule id="100903" level="7">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^cert_expiring$</field>
    <description>X.509 certificate expires within 30 days: $(cryptoai.detail)</description>
    <group>pci_dss_12.3.3,dora_rts_2024_1774_art7,</group>
  </rule>
  <rule id="100904" level="10">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^cert_weak_signature$</field>
    <description>Certificate signed with a broken hash (MD5 or SHA-1): $(cryptoai.detail)</description>
    <group>pci_dss_12.3.3,dora_rts_2024_1774_art6,nydfs_500.15,</group>
  </rule>
  <rule id="100905" level="10">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^cert_weak_key$</field>
    <description>Certificate public key below minimum strength: $(cryptoai.detail)</description>
    <group>pci_dss_12.3.3,dora_rts_2024_1774_art6,nydfs_500.15,</group>
  </rule>
  <rule id="100906" level="10">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^tls_legacy_version$</field>
    <description>TLS endpoint negotiated a protocol older than TLS 1.2: $(cryptoai.detail)</description>
    <group>pci_dss_12.3.3,dora_rts_2024_1774_art6,nydfs_500.15,</group>
  </rule>
  <rule id="100907" level="3">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^tls_no_pq_hybrid$</field>
    <description>TLS endpoint negotiated a classical-only key exchange: $(cryptoai.detail)</description>
    <group>pci_dss_12.3.3,pqc_readiness,</group>
  </rule>
  <rule id="100908" level="3">
    <if_sid>100900</if_sid>
    <field name="cryptoai.finding">^ssh_no_pq_kex$</field>

<!-- Add to the agent ossec.conf (or the centralized agent.conf). -->
<wodle name="command">
  <disabled>no</disabled>
  <tag>tesserabom</tag>
  <command>tesserabom scan --out /var/lib/tesserabom/out --baseline /var/lib/tesserabom/baseline.json --sign-key /etc/tesserabom/tesserabom-signing.key</command>
  <interval>12h</interval>
  <run_on_start>yes</run_on_start>
  <timeout>900</timeout>
  <ignore_output>no</ignore_output>
</wodle>
